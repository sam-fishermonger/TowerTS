[gd_resource type="Resource" script_class="PerkTree" format=3]

[ext_resource type="Script" path="res://scripts/data/perk_tree.gd" id="1_tree"]
[ext_resource type="Script" path="res://scripts/data/perk.gd" id="2_perk"]

[sub_resource type="Resource" id="Perk_poudre"]
script = ExtResource("2_perk")
id = "poudre"
display_name = "Poudre fine"
description = "Toutes les tours font 10 % de dégâts en plus."
cost = 1
column = 0.5
row = 0
damage_multiplier = 1.1

[sub_resource type="Resource" id="Perk_longue_vue"]
script = ExtResource("2_perk")
id = "longue_vue"
display_name = "Longue-vue"
description = "Toutes les tours tirent 10 % plus loin."
cost = 1
requires = Array[Resource]([SubResource("Perk_poudre")])
column = 0.0
row = 1
range_multiplier = 1.1

[sub_resource type="Resource" id="Perk_givre"]
script = ExtResource("2_perk")
id = "givre"
display_name = "Givre mordant"
description = "Les ralentissements durent 1 seconde de plus."
cost = 1
requires = Array[Resource]([SubResource("Perk_poudre")])
column = 1.0
row = 1
slow_duration_bonus = 1.0

[sub_resource type="Resource" id="Perk_rouages"]
script = ExtResource("2_perk")
id = "rouages"
display_name = "Rouages huilés"
description = "Toutes les tours tirent 15 % plus vite."
cost = 2
requires = Array[Resource]([SubResource("Perk_longue_vue")])
column = 0.5
row = 2
fire_rate_multiplier = 1.15

[sub_resource type="Resource" id="Perk_artilleur"]
script = ExtResource("2_perk")
id = "artilleur"
display_name = "Maître artilleur"
description = "Toutes les tours font encore 20 % de dégâts en plus."
cost = 3
requires = Array[Resource]([SubResource("Perk_rouages")])
column = 0.5
row = 3
damage_multiplier = 1.2

[sub_resource type="Resource" id="Perk_tresor"]
script = ExtResource("2_perk")
id = "tresor"
display_name = "Trésor de guerre"
description = "Chaque partie commence avec 50 or de plus."
cost = 1
column = 2.5
row = 0
starting_gold_bonus = 50

[sub_resource type="Resource" id="Perk_pillage"]
script = ExtResource("2_perk")
id = "pillage"
display_name = "Pillage"
description = "Les ennemis détruits rapportent 20 % d'or en plus."
cost = 2
