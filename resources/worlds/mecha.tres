[gd_resource type="Resource" script_class="World" format=3]

[ext_resource type="Script" path="res://scripts/data/world.gd" id="1_world"]
[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="2_enemy_data"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/drone.tres" id="e0_drone"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/sentinelle.tres" id="e1_sentinelle"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/chenillard.tres" id="e2_chenillard"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/porte_drones.tres" id="e3_porte_drones"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/titan.tres" id="e4_titan"]
[ext_resource type="Resource" path="res://resources/enemies/mecha/behemoth.tres" id="b0_behemoth"]
[ext_resource type="TileSet" path="res://resources/tilesets/mecha.tres" id="t_tileset"]

[resource]
script = ExtResource("1_world")
display_name = "La Fonderie"
description = "Mecha : des robots blindés, des drones, et des boucliers d'énergie qui se rechargent."
color = Color(0.45, 0.78, 0.95, 1)
enemies = Array[ExtResource("2_enemy_data")]([ExtResource("e0_drone"), ExtResource("e1_sentinelle"), ExtResource("e2_chenillard"), ExtResource("e3_porte_drones"), ExtResource("e4_titan")])
bosses = Array[ExtResource("2_enemy_data")]([ExtResource("b0_behemoth")])
levels = Array[String](["res://scenes/levels/mecha_01.tscn", "res://scenes/levels/mecha_02.tscn", "res://scenes/levels/mecha_03.tscn", "res://scenes/levels/mecha_04.tscn", "res://scenes/levels/mecha_05.tscn", "res://scenes/levels/mecha_06.tscn"])
tileset = ExtResource("t_tileset")
