[gd_resource type="Resource" script_class="World" format=3]

[ext_resource type="Script" path="res://scripts/data/world.gd" id="1_world"]
[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="2_enemy_data"]
[ext_resource type="Resource" path="res://resources/enemies/insectoid/larve.tres" id="e0_larve"]
[ext_resource type="Resource" path="res://resources/enemies/insectoid/rodeur.tres" id="e1_rodeur"]
[ext_resource type="Resource" path="res://resources/enemies/insectoid/scarabee.tres" id="e2_scarabee"]
[ext_resource type="Resource" path="res://resources/enemies/insectoid/ravageur.tres" id="e3_ravageur"]
