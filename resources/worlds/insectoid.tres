[resource]
script = ExtResource("1_world")
display_name = "La Ruche"
description = "Insectoïdes et xénomorphes : des essaims rapides, des carapaces et des couveuses qui éclatent en larves."
color = Color(0.62, 0.42, 0.75, 1)
enemies = Array[ExtResource("2_enemy_data")]([ExtResource("e0_larve"), ExtResource("e1_rodeur"), ExtResource("e2_scarabee"), ExtResource("e3_ravageur"), ExtResource("e4_couveuse")])
levels = Array[String](["res://scenes/levels/level_01.tscn", "res://scenes/levels/level_02.tscn", "res://scenes/levels/level_03.tscn", "res://scenes/levels/level_04.tscn", "res://scenes/levels/level_05.tscn", "res://scenes/levels/level_06.tscn"])
tileset = ExtResource("t_tileset")
