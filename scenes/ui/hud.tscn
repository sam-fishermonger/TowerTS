[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/tower_info_panel.tscn" id="2_info"]
[ext_resource type="Shader" path="res://scripts/effects/damage_vignette.gdshader" id="3_vignette"]
[ext_resource type="PackedScene" path="res://scenes/ui/audio_toggles.tscn" id="4_audio"]
[ext_resource type="Script" path="res://scripts/ui/tower_shop.gd" id="5_shop"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
resource_local_to_scene = true
shader = ExtResource("3_vignette")
shader_parameter/intensity = 0.0

[node name="HUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="DamageFlash" type="ColorRect" parent="."]
unique_name_in_owner = true
material = SubResource("ShaderMaterial_vignette")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 64.0
grow_horizontal = 2

[node name="Margin" type="MarginContainer" parent="TopBar"]
layout_mode = 2
