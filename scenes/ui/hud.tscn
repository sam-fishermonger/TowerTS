theme_override_constants/margin_right = 16

[node name="Row" type="HBoxContainer" parent="TopBar/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="LevelLabel" type="Label" parent="TopBar/Margin/Row"]
