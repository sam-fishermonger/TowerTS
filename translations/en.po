# dans le code ou les scènes, et msgstr sa traduction anglaise. Un texte sans traduction
# reste en français. Voir « Traduction » dans le README.
msgid ""
msgstr ""
"Project-Id-Version: TowerTS\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

