msgid "TowerTS"
msgstr "TowerTS"

msgid "Tower Defense"
msgstr "Tower Defense"

msgid "Prototype v0.3"
msgstr "Prototype v0.3"

msgid "Jouer"
msgstr "Play"

msgid "Campagne"
msgstr "Campaign"

msgid "Continuer"
msgstr "Continue"

msgid "Mondes"
msgstr "Worlds"

msgid "Défi du jour"
msgstr "Daily challenge"

msgid "Conquête"
msgstr "Conquest"

msgid "Prototype : récolte de pierre, ouvriers et tours en chantier."
msgstr "Prototype: stone gathering, workers and towers under construction."

msgid "Éditeur de niveau"
msgstr "Level editor"

msgid "Retour"
msgstr "Back"

msgid "Améliorations"
msgstr "Upgrades"

msgid "Lexique"
msgstr "Codex"

msgid "Succès"
msgstr "Achievements"

msgid "Quitter"
msgstr "Quit"

msgid "Effacer la progression"
msgstr "Erase progress"

msgid "Effacer"
msgstr "Erase"

msgid "Annuler"
msgstr "Cancel"

msgid "Les étoiles de tous les niveaux et les améliorations achetées seront perdues, et seul le premier niveau de La Ruche restera débloqué."
msgstr "The stars of every level and all purchased upgrades will be lost, and only the first level of The Hive will remain unlocked."

msgid "Code Konami : tout est débloqué !"
msgstr "Konami code: everything is unlocked!"

msgid "Démo"
